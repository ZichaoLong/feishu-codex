# 说明：真实 `codex.yaml` 是当前实例自己的 override 文件。
# 命名实例不会继承 default 实例的这份文件。
# 真实配置文件只会保留显式设置过的键。
# 完整可配项始终以同目录 `codex.yaml.example` 为准。
# 配置按严格 schema 读取：未知键、错误类型和显式 null 会直接报错；
# 布尔值/数字不要加引号，列表必须使用 YAML 列表写法。
#
# 默认工作目录；默认值：当前用户 Home 目录
# default_working_dir: /path/to/workspace

# Codex 可执行命令；默认值：codex
# 首次安装时，如检测到稳定的 Codex 启动命令（如 fnm / nvm，或 Windows 上 npm 全局安装），
# 会自动把稳定启动命令写入真实 `codex.yaml`。
# 如果通过 Node 版本管理器管理 Codex，建议填写稳定安装路径，不要写 /run/user/.../fnm_multishells/... 这类临时 shim。
# codex_command: codex

# app-server 地址；默认值：ws://127.0.0.1:8765
# FOCUS 始终在本机拉起并拥有 shared app-server。若默认端口不可用，
# 会自动改用空闲端口，并把实际地址写入本地运行时状态。
# 这里只接受上游支持的 ws://loopback-IP:port（不能写 localhost、wss 或 path）。
# 本地若希望与飞书安全共用同一线程，可使用 focus 或 fcodex；当这里仍是默认值时，
# 它会自动发现当前实际运行的 shared backend 地址。
# app_server_url: ws://127.0.0.1:8765

# Focus Web；新安装默认开启，始终只监听本机 loopback。
# 本机/SSH 使用 focusctl web open；外部访问使用 configured trusted HTTPS proxy，不能直接暴露该端口。
web_enabled: true

# 浏览器标签页使用的部署显示名称；默认值：Focus Web。
# 打开会话后显示“部署显示名称 · 会话名称”；无会话名称时会话侧使用首条 prompt 预览。
# web_display_name: Focus Web

# Web Gateway 当前只接受 127.0.0.1、localhost 或 ::1。
# web_host: 127.0.0.1

# Web Gateway 端口；0 表示每次启动自动选择空闲端口。
# web_port: 0

# Trusted proxy remote mode 仍只监听 loopback，并要求 web_enabled: true 与固定非零 web_port。
# 两项必须同时配置；origin 可使用 canonical DNS、IPv4 或 compressed IPv6 literal，但必须为 HTTPS 且无 path。
# Proxy/private network 必须先拥有认证/ACL；并行访问多实例请使用不同 external host（DNS name 或 IP literal）。
# 完整清单见项目 README 链接的“Focus Web 自部署外部访问”。
# proof verifier 是 proxy 专有随机 proof 的 SHA-256，不要把原始 proof 写入本配置。
# web_trusted_proxy_origin: https://focus.example.com
# web_trusted_proxy_proof_sha256: <64-lowercase-hex-sha256>

# 浏览器会话有效期（秒）；最小值：60；默认值：28800（8 小时）
# web_session_ttl_seconds: 28800

# 浏览器 WebSocket 断开后，同一已认证 document identity 的重连宽限期（秒）；默认值：15。
# 该宽限期只维护 document capability 与页面连续性，不创建或延长 main-turn writer。
# active main turn 仍由 exact interaction lease 与 matching completion 独立结算。
# web_disconnect_grace_seconds: 15

# 仅用于前端开发：覆盖内置静态资源目录。
# web_static_dir: /path/to/focus/web/dist

# app-server 连接超时（秒）；默认值：15
# connect_timeout_seconds: 15

# app-server 请求超时（秒）；默认值：30
# request_timeout_seconds: 30

# 线程创建时声明的服务名；默认值：focus
# service_name: focus

# 默认权限基线；默认值：:danger-full-access
# 说明：这是“技术边界”，决定命令和工具最终在什么文件系统 / 网络权限下运行。
# 可选值：:read-only、:workspace、:danger-full-access
# permissions_profile_id: :danger-full-access

# 默认审批策略；默认值：never
# 说明：这是“审批边界”，决定什么时候需要先经过审批才能继续。
# 可选值：untrusted、on-request、never
# 说明：仓库不再暴露 deprecated 的 on-failure；如旧配置里仍写了它，会自动按 on-request 处理。
# approval_policy: never

# 审批审阅者；当前仅支持：user
# approvals_reviewer: user

# 默认 personality；可选值：friendly / pragmatic / none；默认值：pragmatic
# personality: pragmatic

# 默认模型；默认值：空，表示沿用 Codex 默认
# model: gpt-5.4

# model provider 通常应在上游 ~/.codex/config.toml 中配置。
# 本项目不管理也不向上游注入 provider。

# 默认 service tier；默认值：空
# service_tier: fast

# 默认 reasoning effort；默认值：空
# reasoning_effort: high

# /threads 与 /resume 查询时显式纳入的线程来源；默认值：["cli", "vscode", "exec", "appServer"]
# source_kinds:
#   - cli
#   - vscode
#   - exec
#   - appServer

# /threads 初始展示的线程数量上限；默认值：5
# 说明：点击卡片里的“更多”后会展开全部线程。
# threads_initial_limit: 5

# 单次 thread/list 聚合查询的最大线程数；默认值：100
# thread_list_query_limit: 100

# /resume 后附带的历史预览轮数；默认值：3
# history_preview_rounds: 3

# /resume 成功后是否发送历史预览卡片；默认值：true
# show_history_preview_on_resume: true

# 飞书附件 pending 状态的过期秒数；默认值：1800（30 分钟）
# 说明：附件会先下载到当前工作目录下的 `_feishu_attachments/`，等待同一发送者的下一条文本消费。
# 说明：到期后不会再自动绑定到后续文本，且本地暂存文件会被清理。
# attachment_ttl_seconds: 1800

# 后端静默时终态补偿 watchdog 的触发秒数；默认值：8
# 说明：若 app-server 在 turn 末尾漏发终态通知，超过该时长后会主动做一次 reconcile。
# 说明：仅用于运行态补偿；调大可减少误补偿，调小可更快收敛漏通知。
# mirror_watchdog_seconds: 8

# /compact 出队后等待上游启动通知的最长秒数；默认值：60
# 说明：如果 turn/started 和 contextCompaction item/started 都丢失，超时后会按“状态不可确认”收口本地卡片；当前进程等待 exact lifecycle 证据，不会自动重试。
# compact_start_timeout_seconds: 60

# 运行中主卡片最小 patch 间隔（毫秒）；默认值：700
# stream_patch_interval_ms: 700

# 终态结果卡实际 interactive payload 的 UTF-8 字节预算；默认值：26000
# 只影响 terminal result card / 文本兜底；execution card 按完整 payload 自动分页。
# terminal_result_card_limit: 26000
